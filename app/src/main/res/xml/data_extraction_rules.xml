<?xml version="1.0" encoding="utf-8"?>
<!-- API 31 and above, same scope as backup_rules.xml. Device-to-device transfer never goes through a third party. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
