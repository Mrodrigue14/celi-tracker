<?xml version="1.0" encoding="utf-8"?>
<!--
  API 31 et plus. Meme perimetre que regles_sauvegarde.xml.

  Le transfert d'appareil a appareil reste local aux deux telephones et ne passe
  par aucun service tiers: il porte moins de risque que la sauvegarde
  infonuagique tout en couvrant le cas du remplacement de telephone.

  Une liste d'inclusion est deja une liste blanche.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
